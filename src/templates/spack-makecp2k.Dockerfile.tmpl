#
# Dockerfile generated by Forge2K
# CP2K >= 2026.2 (and master): upstream make_cp2k.sh delegation arm.
#
# Upstream rearranged tools/spack in v2026.2 (cp2k_dev_repo/ ->
# spack_repo/cp2k_dev/, cp2k_deps_all_*.yaml -> cp2k_deps_*.yaml), which
# invalidated both legacy-template references at once. From that boundary
# on, the whole dependency + CP2K build is delegated to the upstream
# repo-root make_cp2k.sh (v2.0: installs its own Spack under cp2k/spack/,
# concretizes from tools/spack/cp2k_deps_*.yaml, builds CP2K with
# CMake+Ninja into cp2k/build and installs into cp2k/install). No tools/spack
# internal path is referenced here, so further rearrangements inside that
# folder stay the upstream script's problem, not this template's. Modeled
# on the official upstream containers tools/docker/Dockerfile.test_spack_*
# (same apt set, same runtime copy pattern: spack opt tree + install tree
# + /etc/ld.so.conf.d/cp2k.conf + ldconfig).
#

FROM ubuntu:24.04 AS build_cp2k

RUN --mount=type=cache,target=/var/cache/apt,id=apt-2404,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-debs && \
    apt-get update -o Acquire::Retries=3 -qq && apt-get install -o Acquire::Retries=3 -qq --no-install-recommends \
    bzip2 ca-certificates cmake g++ gcc gfortran git gnupg libssh-dev libssl-dev \
    libtool libtool-bin lsb-release make patch pkgconf python3 python3-dev \
    python3-pip python3-venv unzip wget xxd xz-utils zlib1g zlib1g-dev zstd \
    && rm -rf /var/lib/apt/lists/*

{{GIT_CLONE}}

# Single delegated invocation: dependencies (Spack; resumable via the
# BUILD_DEPENDENCIES_COMPLETED marker) + CP2K (CMake+Ninja) in one RUN,
# exactly the documented default usage "cd cp2k && ./make_cp2k.sh".
# -cv/-mpi/-gm map 1:1 onto forge2k --variant/--mpi/--cuda; parallelism is
# left to the script's own nproc detection (-j/-np defaults); the script's
# default "folder" source cache (venv + boto3 + local mirror under
# cp2k/spack_cache) is kept as-is — it self-manages its caches.
WORKDIR /opt/cp2k
RUN ./make_cp2k.sh -cv {{VARIANT}} -mpi {{MPI}} -gm {{GPU_MODEL}}

# Normalize the loader-conf location for the runtime COPY below. A BuildKit
# build container has no /.dockerenv, so make_cp2k.sh takes its
# not-in-container branch and writes the collected loader paths to
# <install>/bin/cp2k.conf instead of /etc/ld.so.conf.d/cp2k.conf (observed
# in e2e run 41426255507: the runtime COPY of the /etc path failed "not
# found" while the whole delegated build had succeeded). Under a builder
# that does set IN_CONTAINER=yes the /etc file already exists and the copy
# is skipped; the test makes any future drift loud instead of a missing
# file deep in the runtime stage.
RUN if [ ! -f /etc/ld.so.conf.d/cp2k.conf ] && [ -f /opt/cp2k/install/bin/cp2k.conf ]; then \
        cp /opt/cp2k/install/bin/cp2k.conf /etc/ld.so.conf.d/cp2k.conf; \
    fi && \
    test -f /etc/ld.so.conf.d/cp2k.conf

FROM ubuntu:24.04 AS runtime
RUN --mount=type=cache,target=/var/cache/apt,id=apt-2404,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-debs && \
    apt-get update -o Acquire::Retries=3 -qq && apt-get install -o Acquire::Retries=3 -qq --no-install-recommends \
    ca-certificates g++ gcc gfortran python3 \
    && rm -rf /var/lib/apt/lists/*

# Dependency stack: the whole spack install tree — the environment "view"
# is a symlink farm into opt/spack/<arch>/<hash>, so the view alone cannot
# be copied (the upstream install stage copies the same tree).
COPY --from=build_cp2k /opt/cp2k/spack/spack/opt/spack ./spack/spack/opt/spack
# CP2K install tree: bin/ (cp2k.psmp plus the cp2k/cp2k_shell symlinks and
# the launch wrapper the script writes), share/cp2k/data (the compiled-in
# CP2K data default resolves here), lib/, lsan.supp.
COPY --from=build_cp2k /opt/cp2k/install ./install
# Loader paths the build stage collected against these same absolute
# paths; ldconfig makes them authoritative, LD_LIBRARY_PATH stays unset.
COPY --from=build_cp2k /etc/ld.so.conf.d/cp2k.conf /etc/ld.so.conf.d/cp2k.conf
RUN ldconfig

ENV PATH="/opt/cp2k/install/bin:${PATH}"
WORKDIR /work
ENTRYPOINT ["/opt/cp2k/install/bin/launch"]
CMD ["cp2k", "--version"]
